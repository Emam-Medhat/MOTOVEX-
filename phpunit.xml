"script.js": r'''const bikes = [
  {name:"DOMINAR 400", image:"https://images.unsplash.com/photo-1558981806-ec527fa84c39?auto=format&fit=crop&w=1500&q=90"},
  {name:"TOURING 400", image:"https://images.unsplash.com/photo-1558981403-c5f9899a28bc?auto=format&fit=crop&w=1500&q=90"},
  {name:"ROADSTER 400", image:"https://images.unsplash.com/photo-1558981806-ec527fa84c39?auto=format&fit=crop&w=1500&q=90"}
];
let current = 0;
const heroBike = document.getElementById("heroBike");
const modelTitle = document.querySelector(".model-tile strong");
const numberItems = document.querySelectorAll(".slide-number span:not(.up):not(.down)");
const currentNumber = document.querySelector(".slide-number b");
const toast = document.getElementById("toastMessage");

function showToast(message) {
  toast.textContent = message;
  toast.classList.add("show");
  window.clearTimeout(showToast.timer);
  showToast.timer = window.setTimeout(() => toast.classList.remove("show"), 1800);
}
function setBike(index) {
  current = (index + bikes.length) % bikes.length;
  heroBike.style.opacity = "0.2";
  window.setTimeout(() => {
    heroBike.src = bikes[current].image;
    heroBike.alt = bikes[current].name;
    modelTitle.textContent = bikes[current].name;
    currentNumber.textContent = String(current + 1).padStart(2, "0");
    numberItems.forEach((item, i) => {
      item.style.color = i === current ? "#f1f1f1" : "#51535a";
    });
    heroBike.style.opacity = "1";
  }, 160);
}
document.getElementById("nextBike").addEventListener("click", () => setBike(current + 1));
document.getElementById("prevBike").addEventListener("click", () => setBike(current - 1));

document.querySelectorAll(".info-tile").forEach(tile => {
  tile.addEventListener("click", () => {
    document.querySelectorAll(".info-tile").forEach(item => item.classList.remove("selected"));
    tile.classList.add("selected");
    showToast(tile.querySelector("strong").textContent + " — details selected");
  });
});
document.querySelector(".menu-toggle").addEventListener("click", () => showToast("Menu opened — explore motorcycles"));
document.querySelector(".bag").addEventListener("click", () => showToast("Your saved motorcycles are empty"));
document.getElementById("videoTile").addEventListener("click", () => showToast("Demo video preview"));
document.querySelectorAll('a[href^="#"]').forEach(link => {
  link.addEventListener("click", event => {
    const target = link.getAttribute("href");
    if (target === "#" || !document.querySelector(target)) {
      event.preventDefault();
      showToast("MotoDesign — motorcycle showcase");
    }
  });
});
'''
}
for name, content in files.items():
    with open(os.path.join(base,name),"w",encoding="utf-8") as f: f.write(content)
zip_path="/mnt/data/motodesign-template.zip"
with zipfile.ZipFile(zip_path,"w",zipfile.ZIP_DEFLATED) as z:
    for name in files: z.write(os.path.join(base,name), arcname="motodesign/"+name)
print(zip_path, os.path.getsize(zip_path))



.model-title{position:absolute;left:2%;top:7%;z-index:3;color:#6b6c71;font-family:'Barlow Condensed',sans-serif;font-style:italic;font-weight:700;line-height:.73;transform:skew(-13deg);letter-spacing:1px}.model-title span{display:block;font-size:clamp(35px,4vw,57px);letter-spacing:2px}.model-title strong{display:block;font-size:clamp(60px,7vw,94px);padding-left:27%;font-weight:700}

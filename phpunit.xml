.bike-stage{position:absolute;left:23%;right:18%;top:16%;bottom:16%;display:flex;align-items:center;justify-content:center}.bike-glow{position:absolute;inset:15% 5%;border-radius:50%;background:radial-gradient(ellipse,rgba(120,123,130,.23),transparent 65%);filter:blur(12px)}

.feature-callout{position:absolute;right:4%;top:25%;font-size:10px;color:#c8c9cc;z-index:3}.feature-callout b{font-size:10px;font-weight:500;letter-spacing:.4px}.feature-callout p{font-size:10px;color:#85878d;line-height:1.4;font-style:italic;margin-top:8px}.callout-line{position:absolute;width:82px;height:28px;border-top:1px solid #aaa;transform:skewY(-24deg);right:100%;top:0;margin-right:10px}.callout-line:before{content:"";position:absolute;left:0;top:-4px;width:5px;height:5px;border-left:1px solid #aaa;border-top:1px solid #aaa;transform:rotate(-45deg)}
.slide-number{position:absolute;right:-1.5%;top:40%;display:flex;flex-direction:column;align-items:center;gap:4px;color:#51535a;font-family:'Barlow Condensed',sans-serif;font-size:29px;line-height:1.05}.slide-number b{font-size:48px;font-weight:400;color:#f1f1f1}.slide-number .up,.slide-number .down{font-size:25px;color:#ddd}
.hero-arrows{position:absolute;right:0;bottom:8%;display:flex;gap:10px}.hero-arrows button{width:48px;height:48px;border-radius:50%;border:0;background:#292b31;color:#eee;font-size:34px;font-weight:200;line-height:1;transition:background .2s}.hero-arrows button:hover{background:var(--green)}
.bottom-strip{position:absolute;left:5.2%;right:5.2%;bottom:0;height:124px;display:grid;grid-template-columns:1.15fr 1.12fr 1.12fr 1.12fr 1.12fr 1.12fr;gap:2px;z-index:5}
.bottom-strip button{border:0;text-align:left;color:#eee;min-width:0}.model-tile{background:var(--green);display:flex;flex-direction:column;align-items:center;justify-content:space-between;padding:9px 5px 10px}.model-tile strong{font:600 25px 'Barlow Condensed',sans-serif;letter-spacing:1px}.chevron{font-size:26px;line-height:18px}.chevron.bottom{color:#71cf7a}.info-tile{background:linear-gradient(135deg,#252830,#1d2026);padding:20px 20px;display:flex;flex-direction:column;gap:13px;transition:background .25s}.info-tile:nth-child(3),.info-tile:nth-child(5){background:linear-gradient(130deg,#29312d,#1d2026)}.info-tile strong{font:500 19px 'Barlow Condensed',sans-serif;letter-spacing:.6px}.info-tile span{font-size:11px;line-height:1.35;color:#d2d3d5}.info-tile:hover,.info-tile.selected{background:#30343a}.video-tile{position:relative;overflow:hidden;padding:0;background:#16181c}.video-tile img{width:100%;height:100%;object-fit:cover;filter:brightness(.6)}.play{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);border:1px solid #eee;border-radius:50%;width:35px;height:35px;display:grid;place-items:center;font-size:12px;padding-left:2px}
.toast-message{position:absolute;left:50%;bottom:145px;transform:translateX(-50%);background:#0c9d24;color:white;padding:10px 16px;font-size:12px;opacity:0;pointer-events:none;transition:opacity .25s;z-index:20}.toast-message.show{opacity:1}
@media(max-width:1000px){.showcase{padding:0 3%;height:auto;min-height:850px}.topbar{gap:12px}.nav-link{font-size:9px;letter-spacing:.6px}.brand{top:74px}.bag{right:-3%;width:45px;height:52px}.hero{height:680px}.model-title{top:9%;left:0}.bike-stage{left:10%;right:8%;top:20%;bottom:22%}.hero-copy{bottom:4%;left:0}.touring-note{right:1%;top:4%}.feature-callout{right:0;top:31%}.slide-number{right:0}.bottom-strip{position:relative;left:auto;right:auto;grid-template-columns:repeat(3,1fr);height:auto;margin:0 -3%;}.bottom-strip button{min-height:105px}.video-tile{min-height:105px}.info-tile{padding:15px}.side-social{left:1%;top:30%}}
